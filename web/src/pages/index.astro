---
const title = 'QuickCut';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="QuickCut: CLI-first Rust video renderer for react thread posts." />
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; padding: 4rem 1.5rem; background: #0f172a; color: #e2e8f0; }
      main { max-width: 760px; margin: 0 auto; }
      code { background: #1e293b; padding: .15rem .45rem; border-radius: .35rem; }
      a { color: #38bdf8; }
    </style>
  </head>
  <body>
    <main>
      <h1>QuickCut</h1>
      <p>Rust, CLI-first video renderer for “react thread post” projects. Build MP4s from images + voice with one command.</p>
      <pre><code>quickcut init ./my_video
quickcut check ./my_video
quickcut render ./my_video -o out.mp4</code></pre>
      <p>Source: <a href="https://github.com/nghiahoang/quickcut">github.com/nghiahoang/quickcut</a></p>
    </main>
  </body>
</html>
